/*
 * Copy to config.h and fill in. config.h is gitignored -- it holds your Wi-Fi
 * and MQTT passwords.
 *
 *     cp main/config.h.example main/config.h
 */
#ifndef AMARAN_CONFIG_H
#define AMARAN_CONFIG_H

/* ------------------------------------------------------------------ Wi-Fi */
/* 2.4 GHz only. The ESP32-C5 has a 5 GHz radio but BLE Mesh shares the 2.4 GHz
 * front end, and running Wi-Fi on 5 GHz while the mesh runs on 2.4 GHz has the
 * two radios fighting over one antenna path on the devkit. We pin the band. */
#define WIFI_SSID       "your-2.4ghz-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

/* ------------------------------------------------------------------- MQTT */
#define MQTT_URI        "mqtt://192.168.1.10:1883"
#define MQTT_USERNAME   "your-mqtt-user"
#define MQTT_PASSWORD   "your-mqtt-password"

/* Must be unique per board on the broker. Two clients with the same id evict
 * each other in a loop, and every eviction fires our last will -- that is
 * exactly what "Home Assistant flaps available/unavailable every few seconds"
 * looks like. */
#define DEVICE_ID       "amaran-esp32"

#define HA_DISCOVERY_PREFIX "homeassistant"
#define MQTT_TOPIC_PREFIX   "amaran"

/* ------------------------------------------------------------------- Mesh */

/* Our own unicast address on the amaran mesh -- deliberately the provisioner's.
 *
 * Fixtures address their status replies to 0x0001, always, regardless of who
 * asked. The mesh stack drops any message whose destination is not one of our
 * own element addresses, so sitting anywhere else means we are structurally
 * deaf to every reply. Taking 0x0001 makes those replies ours.
 *
 * Do not run the amaran desktop or iPad app at the same time: it is also
 * 0x0001, and two nodes sharing a unicast address will confuse each other. */
#define AMARAN_NODE_ADDR 0x0001

/* Lowest outbound mesh sequence number this node will use.
 *
 * Every fixture keeps a replay-protection list and silently discards any
 * message from us whose sequence number is not strictly greater than the last
 * one it recorded (Mesh spec 3.8.8). Our seq lives in NVS, so `idf.py
 * erase-flash` restarts it at 0 -- and every fixture that remembers a higher
 * number then ignores us completely, with no error anywhere. The send returns
 * success; the light just never moves.
 *
 * If lights stop responding after an erase, raise this, or use the `seqbump`
 * console command. */
#define AMARAN_SEQ_START 0x400000

#endif /* AMARAN_CONFIG_H */
