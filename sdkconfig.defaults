CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Bluetooth / BLE Mesh -----------------------------------------------
# Bluedroid, not NimBLE: the BLE Mesh stack is far more mature on Bluedroid.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n

CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
# We self-provision, so connectable provisioning adverts would only steal
# airtime from the scan windows that actually matter.
CONFIG_BLE_MESH_PB_GATT=n
CONFIG_BLE_MESH_GATT_PROXY_SERVER=n
CONFIG_BLE_MESH_RELAY=n
CONFIG_BLE_MESH_FRIEND=n
CONFIG_BLE_MESH_LOW_POWER=n
CONFIG_BLE_MESH_SETTINGS=y
# Both of these default to 0, which means "write to NVS on every single
# update" -- roughly 140k flash writes a day, and a worn-out chip.
CONFIG_BLE_MESH_SEQ_STORE_RATE=1000
CONFIG_BLE_MESH_RPL_STORE_TIMEOUT=600
CONFIG_BLE_MESH_SUBNET_COUNT=1
CONFIG_BLE_MESH_APP_KEY_COUNT=2
CONFIG_BLE_MESH_MODEL_KEY_COUNT=2
CONFIG_BLE_MESH_MODEL_GROUP_COUNT=4
CONFIG_BLE_MESH_CRPL=20
# Hear non-mesh adverts too: that is how we know which fixtures are powered on
# and in range, which drives per-light availability in Home Assistant.
CONFIG_BLE_MESH_SUPPORT_BLE_SCAN=y
# Default is 60. Each transmission holds a buffer for its whole retransmit
# span, so a 13-fixture burst drains the pool and the stack starts logging
# "Out of network buffers" and dropping commands on the floor.
CONFIG_BLE_MESH_ADV_BUF_COUNT=120

# Software AES is mandatory, not a preference. With hardware AES the mesh
# stack routes every 16-byte block through esp_aes_process_dma, which does a
# DMA-capable heap allocation per block -- hundreds per second. It eventually
# fails, prints "Encrypt failed (err -22)", and the mesh stops dead.
CONFIG_MBEDTLS_HARDWARE_AES=n

# --- Wi-Fi / coexistence ------------------------------------------------
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# --- Console -------------------------------------------------------------
# Primary console stays on UART0; USB-Serial-JTAG is an output-only mirror.
#
# Making USB the *primary* console gives you an interactive prompt, but it also
# puts the esp_console/linenoise input path on the same peripheral that carries
# the logs -- and that combination wedged the USB peripheral hard twice: no log
# output, and esptool unable to connect until the BOOT button forced download
# mode. Logs over USB are output-only and have never once misbehaved, so the
# control channel lives on MQTT instead (see amaran/bridge/cmd).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# --- Misc ---------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
